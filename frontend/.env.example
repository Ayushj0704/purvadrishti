# Base URL every console API call is built on.
#
# The default keeps requests same-origin and hands them to the Vite proxy
# (see vite.config.ts), which is what dev and `npm run preview` expect. Point it
# at an absolute URL only when the console is served from a different origin
# than the API, e.g. https://api.example.gov.in/api/v1
#
# Health and readiness are served at the API root, not under the version prefix,
# so the client derives that root from this value.
VITE_API_BASE_URL=/api/v1

# Where the dev/preview proxy forwards /api, /health and /ready.
VITE_API_PROXY_TARGET=http://localhost:8000
