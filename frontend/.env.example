# Local dev: the app talks to the Vite /api proxy (vite.config.ts), so no
# value is needed here.
#
# Deployed frontend (Vercel/Netlify/...): set this to the live backend
# INCLUDING the /api/v1 prefix, then redeploy:
#   VITE_API_BASE_URL=https://purvadrishti-api.onrender.com/api/v1
VITE_API_BASE_URL=
