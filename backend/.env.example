APP_ENV=development
# Local: sqlite:///./purvadrishti.db
# Neon: postgresql+psycopg2://USER:PASS@ep-xxx-xxx.neon.tech/purvadrishti?sslmode=require
DATABASE_URL=sqlite:///./purvadrishti.db
JWT_SECRET=change-me-demo-only
CORS_ORIGINS=*
# Firebase FCM optional (dashboard + SSE is primary, no email)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_JSON=
# Multi-channel alerts: dashboard always live; webhook posts for real when URL set;
# email/SMS send only with provider keys, else attempts are logged (never faked).
ALERT_CHANNELS=dashboard,webhook
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_FROM_EMAIL=alerts@example.com
RESEND_API_KEY=
SMS_API_URL=
SMS_API_KEY=
# RBAC: false = open demo; true = Bearer JWT required
AUTH_ENABLED=false
MODEL_PATH=app/ml/models/cashout_xgb.json
REDIS_URL=
